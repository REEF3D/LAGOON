+# Development environment: `pixi run lagoon`, `pixi run test`, `pixi run lint`.
+# Python comes from conda-forge; the two LAGOON packages and Qt (PySide6) from PyPI.
+[workspace]
+name = "lagoon"
+channels = ["conda-forge"]
+platforms = ["osx-arm64", "osx-64", "linux-64", "win-64"]
+
+[dependencies]
+python = ">=3.11,<3.14"
+
+[pypi-dependencies]
+lagoon-format = { path = "lagoon-format", editable = true }
+lagoon-viz = { path = ".", editable = true, extras = ["dev"] }
+
+[tasks]
+lagoon = "python -m lagoonviz"
+test = "pytest"
+lint = { depends-on = ["ruff", "layers"] }
+ruff = "ruff check . && ruff format --check ."
+layers = "lint-imports"
+format = "ruff format ."
