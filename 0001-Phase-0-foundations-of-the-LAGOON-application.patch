new file mode 100644
index 0000000..22c7925
--- /dev/null
+++ b/tests/core/test_commands.py
@@ -0,0 +1,85 @@
+import pytest
+
+from lagoonviz.core import Session
+
+
+def test_add_undo_redo():
+    s = Session()
+    item = s.add_item("free_surface")
+    assert item == "free_surface-1" and item in s.scene
+    s.undo()
+    assert item not in s.scene
+    s.redo()
+    assert item in s.scene and s.scene.get(item).name == "Free surface"
+
+
+def test_redo_keeps_id_and_new_items_do_not_collide():
+    s = Session()
+    a = s.add_item("slice")
+    s.undo()
+    s.redo()
+    b = s.add_item("slice")
+    assert (a, b) == ("slice-1", "slice-2")
+
+
+def test_remove_restores_position():
+    s = Session()
+    ids = [s.add_item("gauge") for _ in range(3)]
+    s.remove_item(ids[1])
+    assert s.scene.ids() == [ids[0], ids[2]]
+    s.undo()
+    assert s.scene.ids() == ids
+
+
+def test_set_property_validates():
+    s = Session()
+    fs = s.add_item("free_surface")
+    s.set_property(fs, "opacity", 0.5)
+    assert s.scene.get(fs).properties["opacity"] == 0.5
+    with pytest.raises(ValueError):
+        s.set_property(fs, "opacity", 2.0)
+    with pytest.raises(ValueError):
+        s.set_property(fs, "colormap", "rainbow")
+    with pytest.raises(ValueError):
+        s.set_property(fs, "nonsense", 1)
+    s.undo()
+    assert s.scene.get(fs).properties["opacity"] == 1.0
+
+
+def test_merge_makes_one_undo_step():
+    s = Session()
+    fs = s.add_item("free_surface")
+    for value in (0.9, 0.8, 0.7):
+        s.set_property(fs, "opacity", value, merge=True)
+    s.stack.end_merge()
+    assert len(s.stack.done) == 2
+    s.undo()
+    assert s.scene.get(fs).properties["opacity"] == 1.0
+
+
+def test_undo_labels():
+    s = Session()
+    s.add_item("slice", name="Mid slice")
+    assert s.stack.undo_label == "Add Mid slice"
+    s.undo()
+    assert s.stack.redo_label == "Add Mid slice" and not s.stack.can_undo
+
+
+def test_new_command_clears_redo():
+    s = Session()
+    s.add_item("gauge")
+    s.undo()
+    s.add_item("slice")
+    assert not s.stack.can_redo
+
+
+def test_ids_after_undo_match_replay():
+    """An undone add must not shift later ids, or recorded scripts would break."""
+    s = Session()
+    s.add_item("slice")
+    s.add_item("slice")
+    s.undo()
+    third = s.add_item("slice")
+    s.set_property(third, "normal", "x")
+    replayed = Session.from_script(s.to_script())
+    assert replayed.scene.to_dict() == s.scene.to_dict()
diff --git a/tests/core/test_scene.py b/tests/core/test_scene.py
new file mode 100644
index 0000000..fddc0fc
--- /dev/null
+++ b/tests/core/test_scene.py
@@ -0,0 +1,65 @@
+import pytest
+
+from lagoonviz.core import Scene, SceneItem
+
+
+def test_insert_order_and_ids():
+    scene = Scene()
+    scene.insert(SceneItem(scene.new_id("slice"), "slice", "A"))
+    scene.insert(SceneItem(scene.new_id("slice"), "slice", "B"))
+    scene.insert(SceneItem(scene.new_id("gauge"), "gauge", "G"), index=0)
+    assert scene.ids() == ["gauge-1", "slice-1", "slice-2"]
+
+
+def test_unknown_kind_rejected():
+    scene = Scene()
+    with pytest.raises(ValueError):
+        scene.insert(SceneItem("x-1", "nonsense", "X"))
+
+
+def test_observer_events():
+    scene = Scene()
+    events = []
+    scene.subscribe(lambda event, item_id: events.append((event, item_id)))
+    scene.insert(SceneItem("gauge-1", "gauge", "G"))
+    scene.update("gauge-1", name="G2")
+    scene.set_time(1.5)
+    scene.pop("gauge-1")
+    assert events == [
+        ("added", "gauge-1"),
+        ("changed", "gauge-1"),
+        ("time", None),
+        ("removed", "gauge-1"),
+    ]
+
+
+def test_save_load_roundtrip(tmp_path):
+    scene = Scene()
+    scene.insert(SceneItem(scene.new_id("gauge"), "gauge", "G", properties={"x": 2.0}))
+    scene.set_time(3.0)
+    path = tmp_path / "s.lagoon-session"
+    scene.save(path)
+    other = Scene()
+    other.load(path)
+    assert other.to_dict() == scene.to_dict()
+    # counters survive, so new ids do not collide
+    assert other.new_id("gauge") == "gauge-2"
+
+
+def test_load_fills_missing_defaults():
+    scene = Scene()
+    scene.load_dict(
+        {
+            "lagoon_session": 1,
+            "items": [
+                {"id": "slice-1", "kind": "slice", "name": "S", "properties": {"normal": "x"}}
+            ],
+        }
+    )
+    props = scene.get("slice-1").properties
+    assert props["normal"] == "x" and props["colormap"] == "balance"
+
+
+def test_rejects_unknown_session_version():
+    with pytest.raises(ValueError):
+        Scene().load_dict({"lagoon_session": 99})
diff --git a/tests/core/test_session.py b/tests/core/test_session.py
new file mode 100644
index 0000000..e8a8563
--- /dev/null
+++ b/tests/core/test_session.py
@@ -0,0 +1,72 @@
+"""The design test: what the GUI does must be reproducible headless from a script or file."""
+
+import subprocess
+import sys
+import textwrap
+
+from lagoonviz.core import Session
+
+
+def build(s: Session) -> None:
+    fs = s.add_item("free_surface", colormap="balance")
+    s.add_item("bathymetry")
+    g = s.add_item("gauge", name="Gauge 1", x=4.5)
+    s.set_property(fs, "exaggeration", 8.0)
+    s.set_visible(g, False)
+    s.rename(fs, "Interface")
+    sl = s.add_item("slice")
+    s.remove_item(sl)
+    s.add_item("slice")
+    s.undo()  # undone commands are not part of the script
+
+
+def test_script_replay_rebuilds_scene():
+    s = Session()
+    build(s)
+    replayed = Session.from_script(s.to_script())
+    assert replayed.scene.to_dict() == s.scene.to_dict()
+
+
+def test_script_starting_from_saved_session(tmp_path):
+    s = Session()
+    build(s)
+    path = tmp_path / "a.lagoon-session"
+    s.save(path)
+    loaded = Session.open(path)
+    loaded.add_item("slice", normal="x")
+    replayed = Session.from_script(loaded.to_script())
+    assert replayed.scene.to_dict() == loaded.scene.to_dict()
+
+
+def test_log_lines():
+    lines = []
+    s = Session()
+    s.subscribe_log(lines.append)
+    fs = s.add_item("free_surface")
+    s.set_property(fs, "opacity", 0.5, merge=True)
+    s.set_property(fs, "opacity", 0.4, merge=True)
+    s.stack.end_merge()
+    s.undo()
+    assert lines == [
+        "session.add_item('free_surface')",
+        "session.set_property('free_surface-1', 'opacity', 0.5)",
+        "session.set_property('free_surface-1', 'opacity', 0.4)  # final value",
+        "# undo: Set opacity",
+    ]
+
+
+def test_core_runs_without_qt(tmp_path):
+    """A recorded script runs in a fresh interpreter without importing Qt."""
+    s = Session()
+    build(s)
+    script = tmp_path / "replay.py"
+    script.write_text(
+        s.to_script()
+        + textwrap.dedent("""
+        import sys
+        assert "PySide6" not in sys.modules, "core imported Qt"
+        print(len(session.scene))
+    """)
+    )
+    out = subprocess.run([sys.executable, str(script)], capture_output=True, text=True, check=True)
+    assert out.stdout.strip() == str(len(s.scene))
diff --git a/tests/gui/test_main_window.py b/tests/gui/test_main_window.py
new file mode 100644
index 0000000..7d23888
--- /dev/null
+++ b/tests/gui/test_main_window.py
@@ -0,0 +1,108 @@
+"""GUI tests (offscreen). The GUI must only drive the core through Session."""
+
+import pytest
+from PySide6.QtCore import QSettings, Qt
+
+from lagoonviz.core import Session
+from lagoonviz.gui.main_window import MainWindow
+
+
+@pytest.fixture
+def window(qtbot, tmp_path):
+    settings = QSettings(str(tmp_path / "settings.ini"), QSettings.IniFormat)
+    win = MainWindow(Session(), settings=settings)
+    win.ask_before_discard = False  # no modal dialog when the test closes the window
+    qtbot.addWidget(win)
+    win.show()
+    return win
+
+
+def test_panels_exist(window):
+    assert set(window.docks) == {"scene", "properties", "plots", "timeline", "console"}
+    assert window.centralWidget().objectName() == "viewport"
+    assert window.windowTitle() == "Untitled - LAGOON"
+
+
+def test_add_action_updates_tree_and_selects(window):
+    window.add_actions["free_surface"].trigger()
+    tree = window.scene_tree.tree
+    assert tree.topLevelItemCount() == 1
+    assert window.scene_tree.selected_id() == "free_surface-1"
+    assert window.properties.item_id == "free_surface-1"
+    assert window.windowTitle().endswith("* - LAGOON")
+
+
+def test_undo_redo_actions(window):
+    window.add_actions["gauge"].trigger()
+    assert window.act_undo.isEnabled() and window.act_undo.text() == "&Undo Add Gauge"
+    window.act_undo.trigger()
+    assert window.scene_tree.tree.topLevelItemCount() == 0
+    assert window.act_redo.isEnabled()
+    window.act_redo.trigger()
+    assert window.scene_tree.tree.topLevelItemCount() == 1
+
+
+def test_visibility_checkbox_runs_command(window):
+    item_id = window.session.add_item("slice")
+    entry = window.scene_tree.tree.topLevelItem(0)
+    entry.setCheckState(0, Qt.Unchecked)
+    assert window.session.scene.get(item_id).visible is False
+    assert window.session.stack.undo_label == "Hide"
+
+
+def test_properties_editor_runs_command(window):
+    item_id = window.session.add_item("free_surface")
+    window.properties.editors["colormap"].setCurrentText("viridis")
+    assert window.session.scene.get(item_id).properties["colormap"] == "viridis"
+    window.properties.editors["opacity"].setValue(0.4)
+    assert window.session.scene.get(item_id).properties["opacity"] == pytest.approx(0.4)
+    # a change made in a script shows up in the panel
+    window.session.set_property(item_id, "colormap", "greys")
+    assert window.properties.editors["colormap"].currentText() == "greys"
+
+
+def test_console_runs_python_and_logs_commands(window):
+    window.console.run("session.add_item('gauge', x=2.5)")
+    assert "gauge-1" in window.session.scene
+    log = window.console.log.toPlainText()
+    assert "session.add_item('gauge', x=2.5)" in log
+    window.console.run("1/0")
+    assert "ZeroDivisionError" in window.console.log.toPlainText()
+
+
+def test_timeline_sets_time(window):
+    window.timeline.slider.setValue(500)
+    assert window.session.scene.time == pytest.approx(30.0)
+    window.session.set_time(15.0)
+    assert window.timeline.slider.value() == 250
+
+
+def test_save_open_and_export_script(window, tmp_path):
+    item_id = window.session.add_item("free_surface", colormap="balance")
+    path = tmp_path / "case.lagoon-session"
+    assert window.save_session_to(path)
+    assert window.windowTitle() == "case.lagoon-session - LAGOON"
+
+    window.session.remove_item(item_id)
+    window.open_session(path)
+    assert item_id in window.session.scene
